# goldbach-web coordinator (goldbach.net01.io): the Rust server (server-rs),
# behind Traefik on the docker bridge. Installed by server/install.sh (deploy.sh).
# server.py is deployed next to it: install.sh falls back to it (a drop-in) when
# the Rust server does not answer after a deploy.
[Unit]
Description=goldbach-web coordinator (goldbach.net01.io)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=goldbach
Group=goldbach
ExecStart=/opt/goldbach/app/server/goldbach-server --db /opt/goldbach/data/goldbach.db --static /opt/goldbach/app/client --bind 172.18.0.1 --port 8090
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/goldbach/data
UMask=0077
MemoryMax=200M
TasksMax=64

[Install]
WantedBy=multi-user.target
